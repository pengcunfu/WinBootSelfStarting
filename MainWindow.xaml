<Window x:Class="WinBootSelfStarting.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WinBootSelfStarting"
        mc:Ignorable="d"
        Title="Windows 启动项管理" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        Icon="icon.ico">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabControl" Grid.Row="0" SelectionChanged="MainTabControl_SelectionChanged">
            <!-- 启动项 Tab -->
            <TabItem Header="启动项" x:Name="StartupTab">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Vertical" Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="搜索：" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="StartupSearchBox" Width="300" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="StartupRefreshButton" Content="刷新" Click="StartupRefreshButton_Click" Margin="0,0,8,0" Width="80" />
                            <Button x:Name="StartupAddButton" Content="添加" Click="StartupAddButton_Click" Margin="0,0,8,0" Width="80" />
                            <Button x:Name="StartupEnableButton" Content="启用" Click="StartupEnableButton_Click" Margin="0,0,8,0" Width="80" />
                            <Button x:Name="StartupDisableButton" Content="禁用" Click="StartupDisableButton_Click" Margin="0,0,8,0" Width="80" />
                            <Button x:Name="StartupRemoveButton" Content="删除" Click="StartupRemoveButton_Click" Width="80" />
                        </StackPanel>
                    </StackPanel>

                    <DataGrid x:Name="StartupGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="250" />
                            <DataGridTextColumn Header="命令/路径" Binding="{Binding Command}" Width="*" />
                            <DataGridTextColumn Header="位置" Binding="{Binding Location}" Width="150" />
                            <DataGridCheckBoxColumn Header="已启用" Binding="{Binding IsEnabled, Mode=OneWay}" Width="80" />
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="启用" Click="StartupEnableButton_Click" />
                                <MenuItem Header="禁用" Click="StartupDisableButton_Click" />
                                <Separator />
                                <MenuItem Header="删除" Click="StartupRemoveButton_Click" />
                                <Separator />
                                <MenuItem Header="刷新" Click="StartupRefreshButton_Click" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 服务 Tab -->
            <TabItem Header="服务" x:Name="ServiceTab">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Vertical" Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="搜索：" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="ServiceSearchBox" Width="300" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ServiceRefreshButton" Content="刷新" Click="ServiceRefreshButton_Click" Margin="0,0,8,0" Width="80" />
                            <Button x:Name="ServiceDisableButton" Content="禁用自启" Click="ServiceDisableButton_Click" Margin="0,0,8,0" Width="80" />
                            <Button x:Name="ServiceDeleteButton" Content="删除服务" Click="ServiceDeleteButton_Click" Width="80" />
                        </StackPanel>
                    </StackPanel>

                    <DataGrid x:Name="ServiceGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="显示名称" Binding="{Binding Name}" Width="250" />
                            <DataGridTextColumn Header="服务名称" Binding="{Binding Id}" Width="200" />
                            <DataGridTextColumn Header="路径" Binding="{Binding Command}" Width="*" />
                            <DataGridTextColumn Header="状态" Binding="{Binding ServiceStatus}" Width="100" />
                            <DataGridTextColumn Header="启动类型" Binding="{Binding StartType}" Width="100" />
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="禁用自启" Click="ServiceDisableButton_Click" />
                                <MenuItem Header="删除服务" Click="ServiceDeleteButton_Click" />
                                <Separator />
                                <MenuItem Header="刷新" Click="ServiceRefreshButton_Click" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 计划任务 Tab -->
            <TabItem Header="计划任务" x:Name="TaskTab">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Vertical" Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="搜索：" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="TaskSearchBox" Width="300" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="TaskRefreshButton" Content="刷新" Click="TaskRefreshButton_Click" Margin="0,0,8,0" Width="80" />
                            <Button x:Name="TaskDisableButton" Content="禁用" Click="TaskDisableButton_Click" Margin="0,0,8,0" Width="80" />
                            <Button x:Name="TaskDeleteButton" Content="删除" Click="TaskDeleteButton_Click" Width="80" />
                        </StackPanel>
                    </StackPanel>

                    <DataGrid x:Name="TaskGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="任务名称" Binding="{Binding Name}" Width="300" />
                            <DataGridTextColumn Header="状态" Binding="{Binding ServiceStatus}" Width="150" />
                            <DataGridTextColumn Header="详情" Binding="{Binding Command}" Width="*" />
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="禁用" Click="TaskDisableButton_Click" />
                                <MenuItem Header="删除" Click="TaskDeleteButton_Click" />
                                <Separator />
                                <MenuItem Header="刷新" Click="TaskRefreshButton_Click" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="1" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" />
        </StatusBar>

    </Grid>
</Window>
